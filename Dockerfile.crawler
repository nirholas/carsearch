# The crawler, run as a Cloud Run Job rather than inside the web container.
#
# Separated on purpose. A crawl takes minutes and drives a browser; a web
# request takes milliseconds and must not compete with it for CPU or be held
# open by it. Cloud Run Jobs also get a real timeout, a retry policy and a
# completion status, which a background task fired from an HTTP handler does not.

FROM mcr.microsoft.com/playwright:v1.63.0-noble AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --omit=optional
COPY src ./src
RUN npx tsc -p tsconfig.json && cp src/store/*.sql dist/store/

FROM mcr.microsoft.com/playwright:v1.63.0-noble
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --omit=optional \
    # impit's native binding is an OPTIONAL dependency of impit, so --omit=optional
    # skips it and the TLS transport throws at first use. The crawler is the only
    # image that needs it; the web image deliberately does not.
    && npm install --no-save impit-linux-x64-gnu@0.14.5 \
    && npm cache clean --force
COPY --from=build /app/dist ./dist
USER pwuser

# CRAWL_ARGS is set per execution, so one image serves every crawl target,
# e.g. "--make porsche --model macan,911 --max-price 40000".
ENV CRAWL_ARGS="--make porsche --model macan"
CMD ["sh", "-c", "node dist/cli.js search $CRAWL_ARGS"]
